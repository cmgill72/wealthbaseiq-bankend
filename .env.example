# Plaid
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret
PLAID_ENV=development
PLAID_CONNECTION_LIMIT=10
PLAID_REDIRECT_URI=
PLAID_WEBHOOK_URL=

# WealthBaseIQ backend hardening
# Generate long random values; do not commit your real .env file.
WEALTHBASEIQ_API_KEY=replace_with_a_long_random_api_key
DATA_ENCRYPTION_KEY=replace_with_a_long_random_encryption_secret
DATA_STORE_PATH=./data/store.enc
BACKGROUND_SYNC_MINUTES=60
PORT=8080
